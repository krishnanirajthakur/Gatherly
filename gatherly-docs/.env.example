# Frontend Firebase configuration (only if Firebase is used by the client).
# These values identify a Firebase project; authorization must be enforced by rules.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Backend-only configuration. Do not prefix server secrets with VITE_.
PORT=3001
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=replace-with-tested-model-tag
ALLOWED_ORIGIN=http://localhost:5173
